# Copy to .env.local. Use a disposable trial account and a non-confidential video.
# Optional Pics.io credentials for npm run login. Leave both blank for manual sign-in.
# Use the password created in Pics.io, not a Google or Microsoft password.
PICSIO_EMAIL=
PICSIO_PASSWORD=

# Optional: use a specific owned video instead of the onboarding clip.
# PICSIO_VIDEO_URL=https://pics.io/preview/YOUR_ASSET_ID
